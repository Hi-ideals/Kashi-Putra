# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public URL of the website (used for share links, sitemap, emails)
APP_URL=http://localhost:5173
# URL where this API is reachable (used for absolute image URLs)
API_URL=http://localhost:5000
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=epaper

# ---------- Security ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h
# Used to encrypt secrets (reCAPTCHA secret, VAPID private key) stored in the database
SETTINGS_ENCRYPTION_KEY=change_this_to_another_long_random_string
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# ---------- Uploads ----------
MAX_UPLOAD_MB=40
MAX_FILES_PER_UPLOAD=60

# ---------- Initial super admin (used by `npm run seed`) ----------
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# ---------- Email (optional; when empty, emails are printed to the console) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ePaper <no-reply@example.com>"

# ---------- Web Push (optional; generated automatically on first run if empty) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Serve the built React app from this server in production (path to frontend/dist)
FRONTEND_DIST=../frontend/dist
